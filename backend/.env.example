# backend 환경변수
# 사용법: cp .env.example .env

NODE_ENV=development
PORT=3000

# PostgreSQL — infra/docker-compose/.env 와 값을 맞춘다
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=queue
DB_PASSWORD=queue_password
DB_NAME=queue_commerce

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — 32자 이상. 운영 환경에서는 반드시 새로 생성해서 사용한다.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
